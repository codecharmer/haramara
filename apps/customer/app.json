{
  "expo": {
    "name": "Haramara",
    "slug": "haramara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haramara",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "mx.haramara.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131110",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "mx.haramara.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131110",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "codecharmers-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "backgroundColor": "#131110",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38213286-0a0d-4392-8c3a-1df7ce407a14"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/38213286-0a0d-4392-8c3a-1df7ce407a14"
    }
  }
}
